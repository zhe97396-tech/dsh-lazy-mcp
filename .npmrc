# The DSH plugin manager installs a workspace-authored bundle as a symlink into
# the profile's node_modules. Node resolves that symlink path as-is (it does not
# realpath it), so pnpm's default isolated layout is unusable here: transitive
# dependencies live under node_modules/.pnpm and are unreachable from the
# symlinked path. A flat (hoisted) layout puts every dependency directly under
# node_modules, which resolves correctly through the symlink.
node-linker=hoisted
